#!/bin/sh

set -eu

hook_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
status=0
read_any=0

while read -r local_ref local_sha remote_ref remote_sha; do
	read_any=1

	case "$local_ref" in
		refs/heads/*)
			if ! sh "$hook_dir/_branch-rules.sh" validate_pre_push "$local_ref"; then
				status=1
			fi
			;;
	esac
done

if [ "$read_any" -eq 0 ]; then
	if ! sh "$hook_dir/_branch-rules.sh" validate_pre_push; then
		status=1
	fi
fi

exit "$status"
